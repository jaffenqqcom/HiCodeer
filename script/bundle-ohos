#!/usr/bin/env bash

set -euo pipefail

# 调用方的终端可能把 rm/unlink/rmdir 换成了包装函数（以 BASH_FUNC_* 导出），并把 BASH_ENV
# 指向一个每启动一层子 shell 就重新 source 的脚本。函数优先级高于 PATH，所以改 PATH 没用；
# 只清函数也不够，下个子 shell 会被 BASH_ENV 装回来，两条必须都清。若包装器的 shebang 指向
# 本机不存在的解释器，脚本会在第一次调用 rm 时以 126 静默退出、且看不出错在哪，故放在最前。
unset BASH_ENV
unset -f rm unlink rmdir 2>/dev/null || true

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options]
Build a HarmonyOS NEXT HAP for HiCodeer.

Builds the Rust crate as a cdylib (libhicodeer.so), stages it into the HAP
project's libs directory, and runs hvigor assembleHap.

Options:
  --release         Build in release mode (default: debug)
  --hap-only        Skip Rust builds; only run ohpm install + hvigor assembleHap
  --rebuild-golden  Force a rebuild of the guest golden disk (also done
                    automatically when guest-init is newer than the golden)
  --check-tls       On HarmonyOS only: verify the compile-time TLS shim
                    against a probe that needs more pthread keys than the
                    platform has, then exit without building anything.
  -h, --help        Display this help and exit.

The command backend is the on-device hicodeerd server: this script cross-compiles
the hicodeerd executable (aarch64-unknown-linux-ohos), generates the fixed
management keys, and assembles hicodeerd.hnp (public) so remote commands run on
the same device as the host app (no VM / QEMU backend).
"
}

# Parse all arguments manually
IS_RELEASE=false
MODE="all"
REBUILD_GOLDEN=false
CHECK_TLS=false
CARGO_ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help)
      help_info
      exit 0
      ;;
    --release)
      IS_RELEASE=true
      shift
      ;;
    --hap-only)
      MODE="hap"
      shift
      ;;
    --rebuild-golden)
      REBUILD_GOLDEN=true
      shift
      ;;
    --check-tls)
      CHECK_TLS=true
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      help_info
      exit 1
      ;;
    *)
      CARGO_ARGS+=("$1")
      shift
      ;;
  esac
done

# ==================== 平台探测 ====================
# HarmonyOS 本机用 harmonybrew 工具链做原生编译；openEuler VM 用交叉编译工具链。
# 判据：.harmonybrew/bin/brew 仅本机存在且稳定。
if [ -x "$HOME/.harmonybrew/bin/brew" ]; then
  BUILD_PLATFORM="harmonyos"
else
  BUILD_PLATFORM="openeuler"
fi

# ==================== 项目路径（一般不随系统变化） ====================
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"            # .../HiCodeer/script
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"           # .../HiCodeer
HAP_DIR="$PROJECT_ROOT/hap"

# 编译期临时目录钉在构建目录内。本机的 /tmp 是只读的 erofs，clang 建不出临时文件就会直接
# 失败（"unable to make temporary file: Read-only file system"）；而 TMPDIR 一旦继承自
# 调用方，换个终端跑就是另一套环境，cargo 会因此判脏重编。固定下来两件事一起解决。
export TMPDIR="$PROJECT_ROOT/target/tmp"
mkdir -p "$TMPDIR"

# ==================== 工具链与路径配置（换系统只改这一块） ====================
# 所有编译器 / 打包工具 / SDK / 签名 / hnpcli / shim 的路径都集中在此，按
# BUILD_PLATFORM 分流；其它段落只引用这里的变量，不在别处硬编码路径。
if [ "$BUILD_PLATFORM" = "harmonyos" ]; then
  # 本机：harmonybrew 提供 rustup/ohos-sdk 原生编译，commandline-ohos 提供打包工具
  BREW_PREFIX="$HOME/.harmonybrew"
  OHOS_SDK_ROOT="$("$BREW_PREFIX/bin/brew" --prefix ohos-sdk 2>/dev/null || echo "$BREW_PREFIX/opt/ohos-sdk")"
  TOOLCHAIN="$HOME/workspace/commandline-ohos"
  # 编译器 / 链接器（OHOS 原生 clang）
  SDK_LLVM_BIN="$OHOS_SDK_ROOT/native/llvm/bin"
  SDK_NATIVE="$OHOS_SDK_ROOT/native"
  # 打包工具
  NODE_CMD="$TOOLCHAIN/node.org/node_22.7.0/bin/node"
  HVIGORW_JS="$TOOLCHAIN/hvigor.org/hvigor_1.0.0/bin/hvigorw.js"
  OHPM_CMD="$TOOLCHAIN/ohpm.org/ohpm_1.1/bin/ohpm"
  NODE_BIN_DIR="$TOOLCHAIN/node.org/node_22.7.0/bin"
  OHPM_BIN_DIR="$TOOLCHAIN/ohpm.org/ohpm_1.1/bin"
  # SDK / 签名 / hnpcli
  export DEVECO_SDK_HOME="$TOOLCHAIN/sdk.org/sdk_1.0.0"
  export OHOS_BASE_SDK_HOME="$TOOLCHAIN/sdk.org/sdk_1.0.0"
  export HARMONYBREW_SDK="$TOOLCHAIN/sdk.org/sdk_1.0.0"
  SIGN_TOOL_JAR="$TOOLCHAIN/sdk.org/sdk_1.0.0/default/openharmony/toolchains/lib/hap-sign-tool.jar"
  HNPCLI="$TOOLCHAIN/sdk.org/sdk_1.0.0/default/openharmony/toolchains/hnpcli"
  # TLS shim（绕过 libc 128 pthread key 上限；rustc/cargo 编译期用）。
  # 仓库里只留源码，产物 .so 落 cargo 的 scratch 目录（路径在下方 SHIM 段拼出），
  # 与 target 同在 <项目根>/target/ohos 下，不给仓库添噪声。
  SHIM_C="$SCRIPT_DIR/ohos-tls-shim.c"
  SHIM_SO=""
  SHIM_NAME="ohos-tls-shim"
  # shim 只作用于编译进程，不能扩散到 hvigor/hnpcli/java，故这些步骤前卸掉 LD_PRELOAD
  NO_SHIM="env -u LD_PRELOAD"
  # 本机工具链上 PATH。rustup 的 cargo/rustc 是 shim，落在 opt/rustup/bin（都是指向
  # rustup 的符号链接），而 brew/bin 里只有 rustup 本体 —— 漏掉前者，脚本会在第一次
  # 调 cargo 时就 command not found。git/coreutils/strip/make 等由 brew/bin 提供。
  export PATH="$BREW_PREFIX/opt/rustup/bin:$BREW_PREFIX/bin:$PATH"
else
  TOOLCHAIN="/mnt/linux_share/workspace/commandline-linux-arm64"
  SDK_LLVM_BIN="$TOOLCHAIN/sdk/default/openharmony/native/llvm/bin"
  SDK_NATIVE="$TOOLCHAIN/sdk/default/openharmony/native"
  NODE_CMD="$TOOLCHAIN/tool/node/bin/node"
  HVIGORW_JS="$TOOLCHAIN/hvigor/bin/hvigorw.js"
  OHPM_CMD="$TOOLCHAIN/ohpm/bin/ohpm"
  NODE_BIN_DIR="$TOOLCHAIN/tool/node/bin"
  OHPM_BIN_DIR="$TOOLCHAIN/ohpm/bin"
  export DEVECO_SDK_HOME="$TOOLCHAIN/sdk"
  export OHOS_BASE_SDK_HOME="$TOOLCHAIN/sdk"
  export HARMONYBREW_SDK="$TOOLCHAIN/sdk"
  SIGN_TOOL_JAR="$TOOLCHAIN/sdk/default/openharmony/toolchains/lib/hap-sign-tool.jar"
  HNPCLI="$TOOLCHAIN/sdk/default/openharmony/toolchains/hnpcli"
  # virtiofs 元数据 shim（放行共享盘 EPERM）；随交叉工具链走，就地复用它的产物
  SHIM_C="$TOOLCHAIN/tool/shim/ohos-meta-shim.c"
  SHIM_SO="$TOOLCHAIN/tool/shim/ohos-meta-shim.so"
  SHIM_NAME="ohos-meta-shim"
  NO_SHIM=""
fi
echo "[hicodeer-ohos-build] BUILD_PLATFORM=$BUILD_PLATFORM"

# ==================== hvigor 的模块解析路径 ====================
# hvigor 载入项目 hvigorfile.ts 时要 require('@ohos/hvigor-ohos-plugin')，node 从该文件所在
# 目录起按 node_modules 逐级向上找；而工具链把插件放在 hvigor 安装目录的同级，两处都不在查找
# 路径上，于是直接报 "Cannot find module '@ohos/hvigor-ohos-plugin'"。这里在构建目录内造一份
# @ohos 软链，用 NODE_PATH 指过去（hvigor 只把它自己算出的路径追加在 NODE_PATH 前面，不覆盖），
# 免得往工程里塞 node_modules。插件与 hvigor 同级，故从 hvigorw.js 反推安装根。
HVIGOR_HOME_DIR="$(cd "$(dirname "$HVIGORW_JS")/.." && pwd)"
HVIGOR_MOD_DIR="$PROJECT_ROOT/target/hvigor-node-modules"
mkdir -p "$HVIGOR_MOD_DIR/@ohos"
ln -sfn "$HVIGOR_HOME_DIR/hvigor" "$HVIGOR_MOD_DIR/@ohos/hvigor"
ln -sfn "$HVIGOR_HOME_DIR/hvigor-ohos-plugin" "$HVIGOR_MOD_DIR/@ohos/hvigor-ohos-plugin"
export NODE_PATH="$HVIGOR_MOD_DIR${NODE_PATH:+:$NODE_PATH}"

OHOS_TARGET="aarch64-unknown-linux-ohos"
CRATE="launch-zed"
OHOS_LIB_NAME="libhicodeer.so"   # 引擎 so 名；须与 NAPI 模块注册名、EntryAbility.moduleName 三方一致

PROFILE_DIR="debug"
BUILD_MODE="debug"
if [ "$IS_RELEASE" = true ]; then
  PROFILE_DIR="release"
  BUILD_MODE="release"
fi

# ==================== 平台相关 shim（LD_PRELOAD） ====================
# 源码路径与名字已在顶部工具链配置块按平台设定；编译与 LD_PRELOAD 挂载放到 cargo
# target 目录确定之后（见下方 SHIM 段）—— HarmonyOS 的垫片产物就落在那个 scratch
# 目录里。两个 shim 都只作用于编译进程，hvigor/hnpcli/java 调用前用 $NO_SHIM 卸掉。

# ==================== Cargo build（OHOS 交叉编译） ====================
# 工具链版本：本仓根 rust-toolchain.toml 指定 1.97.1。此前该工具链组件损坏
# （bin 目录缺 rustc/cargo，cargo 每次自修复失败），故临时绕到 warp 使用的 1.92.0。
# 1.97.1 组件已补全（rustup toolchain install 修复），且 merman 0.7.0 声明
# rust-version="1.95"，必须用 ≥1.95 的工具链，故恢复使用 1.97.1。
export RUSTUP_TOOLCHAIN=1.97.1

# 本机是自举编译：rustc 的 host 三元组必须就等于目标三元组。装错工具链（例如 host
# 是 gnu 的那份）时当场报清楚，而不是拖到链接期才炸。VM 走交叉编译，不适用此断言。
if [ "$BUILD_PLATFORM" = "harmonyos" ]; then
  RS_HOST="$(rustc -vV | sed -n 's/^host: //p')"
  if [ "$RS_HOST" != "$OHOS_TARGET" ]; then
    echo "[hicodeer-ohos-build] ERROR: rustc host='$RS_HOST'，期望 '$OHOS_TARGET'；本机路径要求原生工具链" >&2
    exit 1
  fi
  echo "[hicodeer-ohos-build] rustc $(rustc -V) (host $RS_HOST)"
fi
# 用 commandline-linux-arm64 的 clang wrapper（系统 clang-17 + OHOS target + sysroot）
export CC_aarch64_unknown_linux_ohos="$SDK_LLVM_BIN/clang"
export CXX_aarch64_unknown_linux_ohos="$SDK_LLVM_BIN/clang++"
export AR_aarch64_unknown_linux_ohos="$SDK_LLVM_BIN/llvm-ar"
export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_OHOS_LINKER="$SDK_LLVM_BIN/clang"
export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_OHOS_CXX="$SDK_LLVM_BIN/clang++"

# 完全脱离旧 SDK：覆盖用户 shell 残留的 OHOS 环境变量
# SDK_NATIVE 已在上方平台分支中按平台设定（VM 用交叉 SDK，本机用 harmonybrew ohos-sdk）
export OHOS_NDK_HOME="$SDK_NATIVE"
export CMAKE_TOOLCHAIN_FILE_aarch64_unknown_linux_ohos="$SDK_NATIVE/build/cmake/ohos.toolchain.cmake"
# aws-lc-sys 等 C crate 用 Unix Makefiles generator，需要 make 而非 ninja。
# 路径不能写死 /usr/bin/make：HarmonyOS 本机没有这个路径，make 由 harmonybrew 提供，
# 故按 PATH 解析，解析不到再退回惯用路径。
MAKE_CMD="$(command -v make 2>/dev/null || true)"
if [ -z "$MAKE_CMD" ] && [ -x /usr/bin/make ]; then
  MAKE_CMD="/usr/bin/make"
fi
if [ -z "$MAKE_CMD" ]; then
  echo "[hicodeer-ohos-build] ERROR: make 不在 PATH；本机需 'brew install make'" >&2
  exit 1
fi
export CMAKE_MAKE_PROGRAM="$MAKE_CMD"

# 某些 C crate（zstd-sys/gettext-sys 等）需要额外 C 宏；
# clang-17 把 incompatible-function-pointer-types 当错误，必须显式关闭
export CFLAGS_aarch64_unknown_linux_ohos="-DZSTD_NOVMS -D__ANDROID__ -Wno-incompatible-function-pointer-types"
export RANLIB_aarch64_unknown_linux_ohos="$SDK_LLVM_BIN/llvm-ranlib"

# Rust 编译产物一律留在本项目内：<项目根>/target/ohos。该路径被 .gitignore 的
# "**/target" 覆盖，既不外泄 git 状态，也不往 $HOME 或工作区外丢东西。同一 checkout
# 共用一个 target 子目录，由 cargo 按 <triple>/<profile> 自动隔离。当前用户直接创建
# （无 sudo、无 bind mount）。只动 rust 的 target；hap 的 build（hap/entry/build）
# 由 hvigor 管理，不受影响。
# 注：本机 /storage 是本地盘，硬链接正常；若在 VM 侧落到 virtiofs 共享盘上，该文件
# 系统不支持硬链接，cargo 会退化为逐文件拷贝（更慢）。
RUST_TARGET_ROOT="$PROJECT_ROOT/target/ohos"
# Unique per source checkout: parallel builds of different the host application copies must
# not share a cargo target dir (cargo locks it and fingerprints collide).
PROJECT_NAME="$(basename "$PROJECT_ROOT")"
PROJECT_HASH="$(printf '%s' "$PROJECT_ROOT" | sha256sum | cut -c1-8)"
# Every dir this checkout stages under target/ohos uses this prefix: the project
# name keeps the paths readable, the hash keeps different checkouts of the same
# project apart.
TARGET_PREFIX="${PROJECT_NAME}-${PROJECT_HASH}"
# Single shared cargo target dir for this checkout. launch-zed, hicodeerd
# (OHOS) and hicodeerd (guest linux-gnu) all build into it; cargo keeps their
# units apart by <triple>/<profile>. Created as the current user: no sudo, no
# bind mount. It lives inside the project tree, so nothing lands outside it.
SHARED_TARGET_DIR="$RUST_TARGET_ROOT/${TARGET_PREFIX}-target"
mkdir -p "$SHARED_TARGET_DIR"

# ==================== 编译期 shim（LD_PRELOAD） ====================
# 两个平台的 shim 都只作用于编译进程；hvigor/hnpcli/java 调用前用 $NO_SHIM 卸掉
# （见各自调用处）。HarmonyOS 的 TLS 垫片编译产物写进 cargo 的 scratch 目录 ——
# 与 target 同在 <项目根>/target/ohos 下，仓库里只留源码，不给 git 状态添噪声。
SCRATCH_DIR="$SHARED_TARGET_DIR/ohos-harmony"
mkdir -p "$SCRATCH_DIR"
if [ -z "$SHIM_SO" ]; then
  SHIM_SO="$SCRATCH_DIR/$SHIM_NAME.so"
fi
if [ ! -f "$SHIM_SO" ] || [ "$SHIM_C" -nt "$SHIM_SO" ]; then
  echo "[hicodeer-ohos-build] 编译 $SHIM_NAME -> $SHIM_SO"
  if [ "$BUILD_PLATFORM" = "harmonyos" ]; then
    "$SDK_LLVM_BIN/clang" -shared -fPIC -O2 -o "$SHIM_SO" "$SHIM_C" -ldl
  else
    gcc -shared -fPIC -o "$SHIM_SO" "$SHIM_C" -ldl
  fi
fi
# 纯赋值而非追加外部值：垫片只服务于本脚本的编译进程，外部若挂着别的 preload 会混进来，
# 既污染编译结果，又让 cargo 的构建环境随终端漂移。
export LD_PRELOAD="$SHIM_SO"
echo "[hicodeer-ohos-build] LD_PRELOAD=$SHIM_SO ($SHIM_NAME)"

# needs_strip <elf> — success when the file still carries a symbol table or
# DWARF sections. One engine lib (libz.so) ships pre-stripped; rewriting it on
# every build is a no-op that only churns the archive (it even grew 240 B when
# stripped twice). Everything else is a candidate.
needs_strip() {
  command -v readelf >/dev/null 2>&1 || return 0
  local out
  out="$(readelf -S -W "$1" 2>/dev/null || true)"
  case "$out" in
    *".symtab"*|*".debug_"*) return 0 ;;
    *) return 1 ;;
  esac
}

# NAPI 模块注册名：napi-derive-ohos 用 NAPI_BUILD_TARGET_NAME > CARGO_CRATE_NAME > CARGO_PKG_NAME
# 决定 nm_modname。so 名由 launch-zed 的 [lib] name 决定（libhicodeer.so）；三者必须一致，
# 否则 loadNativeModule 找不到模块。故把 NAPI_BUILD_TARGET_NAME 设为与 so 文件名、
# EntryAbility.moduleName 相同的取值（见下一行）。
export NAPI_BUILD_TARGET_NAME=hicodeer

# 全量编译加 -A warnings 避免既有警告阻塞；
# codegen-units=16 降低编译内存峰值
export RUSTFLAGS="${RUSTFLAGS:-} -A warnings"
if [ "$IS_RELEASE" = true ]; then
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
else
  export CARGO_PROFILE_DEV_CODEGEN_UNITS=16
fi

# ==================== TLS 垫片自检（--check-tls） ====================
# 造一个 thread_local 数量远超平台上限的探针：OHOS 的 libc 只给 128 个 pthread key，
# 而 std 在这个 target 上用 pthread key 实现 thread_local!，所以不带垫片跑必然
# "out of TLS keys"，带垫片跑必须算出正确和。用来在漫长编译之前先把垫片证实/证伪，
# 免得把垫片问题误判成代码问题。只在 --check-tls 时执行，正文流程不跑。
TLS_PROBE_THREAD_LOCALS=200
# 探针把 0..N-1 累加，期望和 = N*(N-1)/2
TLS_PROBE_EXPECTED_SUM=$(( TLS_PROBE_THREAD_LOCALS * (TLS_PROBE_THREAD_LOCALS - 1) / 2 ))
TLS_PROBE_RS="$SCRATCH_DIR/tls_probe.rs"
TLS_PROBE_BIN="$SCRATCH_DIR/tls_probe"

run_tls_check() {
  if [ "$BUILD_PLATFORM" != "harmonyos" ]; then
    echo "[hicodeer-ohos-build] ERROR: --check-tls 只对本机 TLS 垫片有意义（当前平台 $BUILD_PLATFORM）" >&2
    exit 1
  fi
  echo "[hicodeer-ohos-build] TLS 自检：生成含 $TLS_PROBE_THREAD_LOCALS 个 thread_local 的探针"
  python3 - "$TLS_PROBE_RS" "$TLS_PROBE_THREAD_LOCALS" <<'PY'
import sys

path, count = sys.argv[1], int(sys.argv[2])
lines = ["use std::cell::Cell;"]
for i in range(count):
    lines.append("thread_local!(static TL_%d: Cell<u32> = const { Cell::new(%d) });" % (i, i))
lines.append("fn main() {")
lines.append("    let mut sum: u32 = 0;")
for i in range(count):
    lines.append("    TL_%d.with(|c| { sum = sum.wrapping_add(c.get()); });" % i)
lines.append('    println!("sum={sum}");')
lines.append("}")
with open(path, "w") as handle:
    handle.write("\n".join(lines) + "\n")
PY
  rustc "$TLS_PROBE_RS" -o "$TLS_PROBE_BIN"

  NO_SHIM_RESULT="$(LD_PRELOAD="" "$TLS_PROBE_BIN" 2>&1 || true)"
  SHIM_RESULT="$(LD_PRELOAD="$SHIM_SO" "$TLS_PROBE_BIN" 2>&1 || true)"
  echo "[hicodeer-ohos-build] 不带垫片 -> ${NO_SHIM_RESULT:-<无输出>}"
  echo "[hicodeer-ohos-build] 带垫片   -> ${SHIM_RESULT:-<无输出>}"

  if [ "$SHIM_RESULT" != "sum=$TLS_PROBE_EXPECTED_SUM" ]; then
    echo "[hicodeer-ohos-build] ERROR: 垫片自检失败，期望 'sum=$TLS_PROBE_EXPECTED_SUM'，实得 '${SHIM_RESULT:-<无输出>}'" >&2
    exit 1
  fi
  echo "[hicodeer-ohos-build] 垫片自检通过"
}

if [ "$CHECK_TLS" = true ]; then
  run_tls_check
  exit 0
fi

cd "$PROJECT_ROOT"

# --hap-only 跳过 launch-zed 编译与 so 拷贝，直接复用现有 libhicodeer.so
if [ "$MODE" != "hap" ]; then
  NPROC=$(nproc 2>/dev/null || echo 4)
  OHOS_TARGET_DIR="$SHARED_TARGET_DIR"
  echo "[hicodeer-ohos-build] Cargo build ($PROFILE_DIR, $NPROC CPUs) ..."
  # Default backend feature the daemon-agent (cmd-client -> on-device daemon). No
  # feature flags are passed; the retired openeuler-agent / qemu-agent features
  # are gone.
  CARGO_TARGET_DIR="$OHOS_TARGET_DIR" \
    cargo build $($IS_RELEASE && echo --release) --lib -p "$CRATE" --target "$OHOS_TARGET" -j "$NPROC" "${CARGO_ARGS[@]}"

  # ==================== 拷贝 libhicodeer.so ====================
  HAP_LIBS_DIR="$HAP_DIR/entry/libs/arm64-v8a"
  mkdir -p "$HAP_LIBS_DIR"
  # launch-zed 的 [lib] name 与 so 文件名一致，产物直接是 libhicodeer.so（无需改名）
  cp "$OHOS_TARGET_DIR/$OHOS_TARGET/$PROFILE_DIR/libhicodeer.so" "$HAP_LIBS_DIR/$OHOS_LIB_NAME"
  # Keep an unstripped copy for symbolizing device crashes (addr2line against
  # this archive recovers functions/lines from hilog backtraces). The HAP copy
  # is stripped below: its full .symtab (~0.5G) plus DWARF debug sections
  # (~0.3G) made hvigor zip/sign peak memory exceed the 11G RAM on every code
  # change (a full 1.3G repack), OOM-rebooting the host. Stripping cuts
  # libhicodeer.so ~1.3G -> ~0.45G while dynamic (napi) exports are preserved.
  SYMBOL_DIR="$RUST_TARGET_ROOT/${TARGET_PREFIX}-libhicodeer-symbols"
  mkdir -p "$SYMBOL_DIR"
  cp "$OHOS_TARGET_DIR/$OHOS_TARGET/$PROFILE_DIR/libhicodeer.so" "$SYMBOL_DIR/libhicodeer.so"
  if command -v strip >/dev/null 2>&1; then
    if strip "$HAP_LIBS_DIR/$OHOS_LIB_NAME"; then
      echo "[hicodeer-ohos-build] $OHOS_LIB_NAME stripped ($(du -h "$HAP_LIBS_DIR/$OHOS_LIB_NAME" | cut -f1)); unstripped kept at $SYMBOL_DIR"
    else
      echo "[hicodeer-ohos-build] WARNING: strip failed; HAP keeps unstripped $OHOS_LIB_NAME" >&2
    fi
  else
    echo "[hicodeer-ohos-build] WARNING: no strip tool; HAP keeps unstripped $OHOS_LIB_NAME" >&2
  fi
  echo "[hicodeer-ohos-build] $OHOS_LIB_NAME staged at $HAP_LIBS_DIR/$OHOS_LIB_NAME"
fi

# ==================== 命令守护进程编译 + 固定钥匙 + HNP 装配 ====================
# The daemon is the on-device command server (replaces the retired cmd-agentd/VM
# and qemu-ssh-agentd/QEMU backends). It runs ON the OHOS device, so it is
# compiled with the OHOS (musl) target - unlike the old VM servers which used
# the host gnu toolchain. The fixed management keys are generated per build: the
# server half ships inside the daemon's public HNP conf dir, the client half goes
# into the HAP resfile for cmd-client (both halves install together in the same
# HAP, so they always match). The daemon HNP is assembled into
# hap/entry/hnp/arm64-v8a/ and injected + re-signed by the HNP section below.
HAP_RESFILE_DIR="$HAP_DIR/entry/src/main/resources/resfile"
DAEMON_MANIFEST="$PROJECT_ROOT/crates/gpui_ohos/depend/cmd-agent/hicodeerd/Cargo.toml"
HNP_SRC_DIR="$HAP_DIR/entry/hnp/arm64-v8a"
mkdir -p "$HAP_RESFILE_DIR" "$HNP_SRC_DIR"

if [ "$MODE" != "hap" ]; then
  DAEMON_TARGET_DIR="$SHARED_TARGET_DIR"
  echo "[hicodeer-ohos-build] Building hicodeerd (OHOS $OHOS_TARGET) ..."
  CARGO_TARGET_DIR="$DAEMON_TARGET_DIR" \
    cargo build --release --manifest-path "$DAEMON_MANIFEST" --target "$OHOS_TARGET" -j "$NPROC"
  DAEMON_BIN="$DAEMON_TARGET_DIR/$OHOS_TARGET/release/hicodeerd"
  if [ ! -x "$DAEMON_BIN" ]; then
    echo "[hicodeer-ohos-build] ERROR: hicodeerd binary missing: $DAEMON_BIN" >&2
    exit 1
  fi

  # Regenerate the fixed management key pairs on every build: each HAP must ship
  # a fresh set so keys left on a device from an older build never match.
  KEYS_DIR="$RUST_TARGET_ROOT/${TARGET_PREFIX}-hicodeerd-keys"
  mkdir -p "$KEYS_DIR"
  rm -f "$KEYS_DIR"/mgmt_host_key "$KEYS_DIR"/mgmt_host_key.pub \
        "$KEYS_DIR"/mgmt_client_key "$KEYS_DIR"/mgmt_client_key.pub
  ssh-keygen -t ed25519 -N '' -f "$KEYS_DIR/mgmt_host_key" -q
  ssh-keygen -t ed25519 -N '' -f "$KEYS_DIR/mgmt_client_key" -q

  # Stage the public-HNP payload: <pkg>/bin/<daemon binary> + <pkg>/conf/<server keys>.
  STAGE_DIR="$RUST_TARGET_ROOT/${TARGET_PREFIX}-hicodeerd-stage"
  mkdir -p "$STAGE_DIR/hicodeerd/bin" "$STAGE_DIR/hicodeerd/conf"
  cp "$DAEMON_BIN" "$STAGE_DIR/hicodeerd/bin/hicodeerd"
  chmod 755 "$STAGE_DIR/hicodeerd/bin/hicodeerd"
  cp "$KEYS_DIR/mgmt_host_key" "$STAGE_DIR/hicodeerd/conf/mgmt_host_key"
  cp "$KEYS_DIR/mgmt_client_key.pub" "$STAGE_DIR/hicodeerd/conf/authorized_keys"
  chmod 600 "$STAGE_DIR/hicodeerd/conf/mgmt_host_key"
  # The Node preload is compiled into the daemon and re-materialised at runtime
  # under the data root, so the package carries no copy of it.
  cat > "$STAGE_DIR/hicodeerd/hnp.json" <<'JSON'
{"type":"hnp-config","name":"hicodeerd","version":"0.1.0","install":{}}
JSON

  # Client half of the management keys -> resfile (cmd-client reads them).
  mkdir -p "$HAP_RESFILE_DIR/hicodeerd-mgmt"
  rm -f "$HAP_RESFILE_DIR/hicodeerd-mgmt/mgmt-host.pub" "$HAP_RESFILE_DIR/hicodeerd-mgmt/mgmt-client-key"
  cp "$KEYS_DIR/mgmt_host_key.pub" "$HAP_RESFILE_DIR/hicodeerd-mgmt/mgmt-host.pub"
  cp "$KEYS_DIR/mgmt_client_key" "$HAP_RESFILE_DIR/hicodeerd-mgmt/mgmt-client-key"
  chmod 600 "$HAP_RESFILE_DIR/hicodeerd-mgmt/mgmt-client-key"

  # 用官方 OpenHarmony 打包工具 hnpcli 装配 daemon HNP。hnpcli 路径已在平台分支设定
  # （本机为 commandline-ohos 的 OHOS 原生版；VM 为交叉 SDK 的 box64 包装版），此处不再重定义。
  # hnpcli 从 staged hnp.json 读取包名/版本，向 -o 输出 <name>.hnp。
  # HNPCLI 已在平台分支中按平台设定（本机用 commandline-ohos 的 OHOS 原生版，
  # VM 用交叉 SDK 的 box64 包装版），此处不再重定义。
  if [ ! -x "$HNPCLI" ]; then
    echo "[hicodeer-ohos-build] ERROR: hnpcli 不可用 ($HNPCLI)；HarmonyOS 本机需先编译 OHOS 原生版 hnpcli 放入 commandline-ohos 对应目录" >&2
    exit 1
  fi
  echo "[hicodeer-ohos-build] Assembling hicodeerd.hnp (hnpcli) ..."
  rm -f "$HNP_SRC_DIR/hicodeerd.hnp"
  $NO_SHIM "$HNPCLI" pack -i "$STAGE_DIR/hicodeerd" -o "$HNP_SRC_DIR"
  if [ ! -f "$HNP_SRC_DIR/hicodeerd.hnp" ]; then
    echo "[hicodeer-ohos-build] ERROR: hnpcli did not produce $HNP_SRC_DIR/hicodeerd.hnp" >&2
    exit 1
  fi
  echo "[hicodeer-ohos-build] hicodeerd.hnp staged at $HNP_SRC_DIR/hicodeerd.hnp"
fi

# ==================== Embedded QEMU guest packaging ====================
# The staging below copies the current QEMU guest resources (the HiSH-derived
# kernel, engine native libs, the statically linked guest daemon and the guest
# management keys) into the HAP resfile. The guest userland itself is not staged
# here: it lives inside golden.qcow2 (see goldendisk/build-golden.sh).
QEMU_IMG_DIR="$PROJECT_ROOT/crates/gpui_ohos/depend/qemu-mngt/images"
QEMU_HAP_LIBS_DIR="$HAP_DIR/entry/libs/arm64-v8a"
mkdir -p "$QEMU_HAP_LIBS_DIR"

if [ "$MODE" != "hap" ]; then
  echo "[hicodeer-ohos-build] Packaging embedded QEMU guest ..."

  # 1) Guest daemon (Linux aarch64) binary. The host is aarch64 OpenEuler, so
  # the native gnu toolchain is used (no cross compiler). It is linked
  # statically on purpose: the guest userland is Alpine (musl), which has no
  # glibc for a dynamic binary to resolve against, and a static link sidesteps
  # that entirely (verified: statically linked, no PT_INTERP, no .dynamic
  # section). The target-scoped RUSTFLAGS keep the flag off the build scripts
  # and every other crate in the dependency graph.
  # 仅 openEuler VM 能原生编 guest（需 gnu 工具链）；HarmonyOS 本机不重打。
  if [ "$BUILD_PLATFORM" = "openeuler" ]; then
    GUEST_TARGET="aarch64-unknown-linux-gnu"
    GUEST_TARGET_DIR="$SHARED_TARGET_DIR"
    echo "[hicodeer-ohos-build] Building hicodeerd (guest $GUEST_TARGET, static) ..."
    CARGO_TARGET_DIR="$GUEST_TARGET_DIR" \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-C target-feature=+crt-static" \
      cargo build --release --manifest-path "$DAEMON_MANIFEST" --target "$GUEST_TARGET" -j "$NPROC" \
      || echo "[hicodeer-ohos-build] WARNING: guest hicodeerd build failed (guest may be unavailable)" >&2
    GUEST_BIN="$GUEST_TARGET_DIR/$GUEST_TARGET/release/hicodeerd"
    if [ -x "$GUEST_BIN" ]; then
      mkdir -p "$HAP_RESFILE_DIR/qemu-guest"
      cp "$GUEST_BIN" "$HAP_RESFILE_DIR/qemu-guest/hicodeerd"
      chmod 755 "$HAP_RESFILE_DIR/qemu-guest/hicodeerd"
    else
      echo "[hicodeer-ohos-build] WARNING: guest hicodeerd binary missing: $GUEST_BIN" >&2
    fi
  else
    echo "[hicodeer-ohos-build] HarmonyOS 本机跳过 guest hicodeerd 编译（需 openEuler gnu 工具链）；QEMU guest 模式本机不可用"
  fi

  # 1b) Golden mother disk. Built from qemu-mngt/goldendisk when absent or when
  # --rebuild-golden was passed; a failed build aborts the whole bundle so the
  # HAP never ships a stale or missing golden.
  # 仅 openEuler VM 能构建 golden（build-golden.sh 需交叉环境）；HarmonyOS 本机不重打。
  if [ "$BUILD_PLATFORM" = "openeuler" ]; then
    GOLDEN_DEST="$HAP_RESFILE_DIR/qemu-guest/golden.qcow2"
    GOLDEN_SCRIPT="$PROJECT_ROOT/crates/gpui_ohos/depend/qemu-mngt/goldendisk/build-golden.sh"
    GOLDEN_CACHE="$RUST_TARGET_ROOT/${TARGET_PREFIX}-golden"
    GUEST_INIT_DIR="$PROJECT_ROOT/crates/gpui_ohos/depend/qemu-mngt/guest-init"
    GOLDEN_STALE=false
    if [ -f "$GOLDEN_DEST" ] && [ -d "$GUEST_INIT_DIR" ] \
       && [ -n "$(find "$GUEST_INIT_DIR" -type f -newer "$GOLDEN_DEST" 2>/dev/null)" ]; then
      GOLDEN_STALE=true
    fi
    if [ "$REBUILD_GOLDEN" = "true" ] || [ ! -f "$GOLDEN_DEST" ] || [ "$GOLDEN_STALE" = "true" ]; then
      if [ "$GOLDEN_STALE" = "true" ] && [ "$REBUILD_GOLDEN" != "true" ]; then
        echo "[hicodeer-ohos-build] guest-init is newer than golden.qcow2; rebuilding the golden"
      fi
      echo "[hicodeer-ohos-build] Building guest golden disk -> $GOLDEN_DEST"
      if ! bash "$GOLDEN_SCRIPT" "$GOLDEN_DEST" "$GOLDEN_CACHE"; then
        echo "[hicodeer-ohos-build] ERROR: golden disk build failed; aborting" >&2
        exit 1
      fi
      echo "[hicodeer-ohos-build] NOTE: an already-installed app keeps its old working disk; uninstall before reinstalling"
    else
      echo "[hicodeer-ohos-build] golden.qcow2 present and newer than guest-init (pass --rebuild-golden to force)"
    fi
  else
    GOLDEN_DEST="$HAP_RESFILE_DIR/qemu-guest/golden.qcow2"
    if [ -f "$GOLDEN_DEST" ]; then
      echo "[hicodeer-ohos-build] 复用仓库预置 golden.qcow2（本机不重打）"
    else
      echo "[hicodeer-ohos-build] WARNING: 本机无 golden.qcow2 且不可构建，QEMU guest 模式将不可用" >&2
    fi
  fi

  # 2) Guest management key pair, independent from the on-device daemon keys. The
  # client half is read by cmd-client in QEMU mode; the server halves are staged
  # by qemu_runtime into files/qemu/guest-conf at launch for the guest daemon.
  # Guest management key pair: regenerated every build, independent from the
  # on-device daemon keys.
  GUEST_KEYS_DIR="$RUST_TARGET_ROOT/${TARGET_PREFIX}-hicodeerd-guest-keys"
  mkdir -p "$GUEST_KEYS_DIR"
  rm -f "$GUEST_KEYS_DIR"/mgmt_host_key "$GUEST_KEYS_DIR"/mgmt_host_key.pub \
        "$GUEST_KEYS_DIR"/mgmt_client_key "$GUEST_KEYS_DIR"/mgmt_client_key.pub
  ssh-keygen -t ed25519 -N '' -f "$GUEST_KEYS_DIR/mgmt_host_key" -q
  ssh-keygen -t ed25519 -N '' -f "$GUEST_KEYS_DIR/mgmt_client_key" -q
  mkdir -p "$HAP_RESFILE_DIR/hicodeerd-mgmt-guest"
  cp "$GUEST_KEYS_DIR/mgmt_host_key.pub" "$HAP_RESFILE_DIR/hicodeerd-mgmt-guest/mgmt-host.pub"
  cp "$GUEST_KEYS_DIR/mgmt_client_key" "$HAP_RESFILE_DIR/hicodeerd-mgmt-guest/mgmt-client-key"
  cp "$GUEST_KEYS_DIR/mgmt_host_key" "$HAP_RESFILE_DIR/hicodeerd-mgmt-guest/mgmt_host_key"
  cp "$GUEST_KEYS_DIR/mgmt_client_key.pub" "$HAP_RESFILE_DIR/hicodeerd-mgmt-guest/authorized_keys"
  chmod 600 "$HAP_RESFILE_DIR/hicodeerd-mgmt-guest/mgmt-host.pub" \
            "$HAP_RESFILE_DIR/hicodeerd-mgmt-guest/mgmt-client-key" \
            "$HAP_RESFILE_DIR/hicodeerd-mgmt-guest/mgmt_host_key" \
            "$HAP_RESFILE_DIR/hicodeerd-mgmt-guest/authorized_keys"

  # 3) Guest kernel from images/ into resfile (skip when absent). There is no
  # initramfs: the kernel boots the golden's own userland directly as root.
  if [ -f "$QEMU_IMG_DIR/Image" ]; then
    cp -f "$QEMU_IMG_DIR/Image" "$HAP_RESFILE_DIR/Image"
  else
    echo "[hicodeer-ohos-build] WARNING: no guest kernel Image in images/" >&2
  fi
  # 4) Engine native libs into hap libs. The HiSH engine links glib, pixman,
  # pcre2 and intl into itself, so only slirp and zlib stay external. zlib ships
  # under the bare name the engine asks for (its DT_NEEDED is "libz.so").
  #
  # These arrive as external inputs, so unlike libhicodeer.so they are stripped
  # here instead of at the source: images/ keeps the symbols, only the HAP copy
  # loses them. Measured on the shipped engine: libqemu-system-aarch64.so drops
  # 52,481,120 -> 41,373,552 bytes, libslirp.so.0 558,816 -> 213,440 (10.6 MB off
  # every package). The dynamic symbol table survives untouched - 22,333 entries
  # before and after, with main, qemu_fsdev_add and the SONAME/DT_NEEDED set all
  # intact - so dlopen + dlsym("main") and vhost-user-fs still resolve. An
  # unstripped copy per lib is archived beside libhicodeer.so's symbol dir so an
  # engine crash backtrace can still be symbolized with addr2line.
  QEMU_SYMBOL_DIR="$RUST_TARGET_ROOT/${TARGET_PREFIX}-qemu-engine-symbols"
  mkdir -p "$QEMU_SYMBOL_DIR"
  for so in libqemu-system-aarch64.so libslirp.so.0 libz.so; do
    if [ ! -f "$QEMU_IMG_DIR/$so" ]; then
      echo "[hicodeer-ohos-build] WARNING: engine lib missing from images/: $so" >&2
      continue
    fi
    cp -f "$QEMU_IMG_DIR/$so" "$QEMU_SYMBOL_DIR/$so"
    cp -f "$QEMU_IMG_DIR/$so" "$QEMU_HAP_LIBS_DIR/$so"
    if ! command -v strip >/dev/null 2>&1; then
      echo "[hicodeer-ohos-build] WARNING: no strip tool; HAP keeps unstripped $so" >&2
    elif ! needs_strip "$QEMU_HAP_LIBS_DIR/$so"; then
      echo "[hicodeer-ohos-build] $so is already stripped; HAP copy left as is"
    elif strip "$QEMU_HAP_LIBS_DIR/$so"; then
      echo "[hicodeer-ohos-build] $so stripped ($(du -h "$QEMU_HAP_LIBS_DIR/$so" | cut -f1)); unstripped kept at $QEMU_SYMBOL_DIR"
    else
      echo "[hicodeer-ohos-build] WARNING: strip failed; HAP keeps unstripped $so" >&2
    fi
  done

  # 5) Guest disk: nothing is packaged here. The empty qcow2 is generated in
  # code at runtime (qemu_runtime.rs write_empty_qcow2) and validated on every
  # start; a shipped template once carried broken refcount entries (4-byte
  # where qcow2 v2 uses 2-byte) and bricked the guest's first boot.
  echo "[hicodeer-ohos-build] QEMU guest resources staged"
fi

# ==================== cmd-agent daemon（线程运行，无需 cdylib） ====================
# The cmd-agent daemon now runs inside the host application process (spawned in launch-zed's
# launch_app.rs), so libcmd_agent.so is no longer built or packaged.

# --server-only 跳过 ohpm install 与 hvigor 打包
if [ "$MODE" != "server" ]; then

# ==================== ohpm install（首次 / 为空 / 有坏符号链接 / 关键 so 链接缺失时） ====================
# 说明：hvigor 在 DevEco Studio 里会自动触发 ohpm install；命令行 assembleHap 不一定触发。
# 新增 Rust so 依赖（libhicodeer.so）后，若 oh_modules 里缺对应符号链接，ArkTS 编译报
# "Cannot find module 'libxxx.so'"。此处兜底：顶层与 entry 两处 oh_modules 的关键 so 链接
# 齐全才跳过 install，否则补跑（顶层 + entry 各一次）。
OHPM_LINK_DEPS=(
  "$OHOS_LIB_NAME"   # 工程 Rust NAPI 引擎库（与 OHOS_LIB_NAME 一致）
)
ohpm_links_missing() {
  # 顶层 oh_modules 关键 so 链接
  local dep
  for dep in "${OHPM_LINK_DEPS[@]}"; do
    if [ ! -L "$HAP_DIR/oh_modules/$dep" ]; then
      return 0
    fi
  done
  # entry 级 oh_modules 关键 so 链接 + @ohos-rs/ability 解析
  for dep in "${OHPM_LINK_DEPS[@]}"; do
    if [ ! -L "$HAP_DIR/entry/oh_modules/$dep" ]; then
      return 0
    fi
  done
  if [ ! -L "$HAP_DIR/entry/oh_modules/@ohos-rs/ability" ]; then
    return 0
  fi
  # entry 级 @ohos-rs/ability 能力插件链接（新增插件必须在此登记）
  local plugin
  for plugin in ability-plugin-cursor ability-plugin-files ability-plugin-pinch ability-plugin-filedrop ability-plugin-ime; do
    if [ ! -L "$HAP_DIR/entry/oh_modules/@ohos-rs/$plugin" ]; then
      return 0
    fi
  done
  # 目录为空或坏符号链接（保留原有兜底）
  local dir
  for dir in "$HAP_DIR/oh_modules" "$HAP_DIR/entry/oh_modules"; do
    if [ ! -d "$dir" ] || [ -z "$(ls -A "$dir" 2>/dev/null)" ]; then
      return 0
    fi
    local link
    while IFS= read -r -d '' link; do
      if [ -L "$link" ] && [ ! -e "$link" ]; then
        return 0
      fi
    done < <(find "$dir" -type l -print0 2>/dev/null)
  done
  return 1
}
if ohpm_links_missing; then
  echo "[hicodeer-ohos-build] ohpm install (top-level) ..."
  PATH="$NODE_BIN_DIR:$OHPM_BIN_DIR:$PATH" \
    bash -c "cd '$HAP_DIR' && '$OHPM_CMD' install --all"
  echo "[hicodeer-ohos-build] ohpm install (entry) ..."
  PATH="$NODE_BIN_DIR:$OHPM_BIN_DIR:$PATH" \
    bash -c "cd '$HAP_DIR/entry' && '$OHPM_CMD' install"
fi

# ==================== 清理 stale cmake/ninja ====================
CXX_DIR="$HAP_DIR/entry/.cxx/default/default/$BUILD_MODE/arm64-v8a"
rm -f "$CXX_DIR/.ninja_log" "$CXX_DIR/.ninja_deps" 2>/dev/null || true

# ==================== hvigor assembleHap ====================
cd "$HAP_DIR"   # hvigor 必须在 HAP 工程根目录运行（找 hvigor-config.json5 / build-profile.json5）
# 停止旧 daemon：hvigor daemon 常驻并缓存启动时的环境变量（DEVECO_SDK_HOME 等）
$NO_SHIM "$NODE_CMD" "$HVIGORW_JS" --stop-daemon 2>/dev/null || true

echo "=== HAP Build ==="
echo "Project : $HAP_DIR"
echo "Node    : $("$NODE_CMD" --version)"
echo "SDK     : $DEVECO_SDK_HOME"
echo "Mode    : $BUILD_MODE"
echo ""

$NO_SHIM "$NODE_CMD" "$HVIGORW_JS" \
  --mode module \
  -p product=default \
  -p buildMode="$BUILD_MODE" \
  assembleHap \
  --info --analyze=normal --parallel --incremental --no-daemon

  # ==================== 清理 cmake staging ====================
  CMAKE_STAGING_DIR="$HAP_DIR/entry/.cmake_staging"
  if [ -d "$CMAKE_STAGING_DIR" ]; then
    find "$CMAKE_STAGING_DIR" -depth -delete 2>/dev/null || true
  fi

  # ==================== HNP 装配（注入载荷 + 重签，默认执行） ====================
  # hvigor 只把 module.json 的 hnpPackages 写进产物、不嵌 .hnp 实体；这里把
  # hap/entry/hnp/arm64-v8a/<pkg>.hnp 追加进 HAP，再用调试证书整体重签。
  # 载荷缺失 / 证书未配齐都会显式报错，不产出“看似可装”的包。
  HNP_SRC_DIR="$HAP_DIR/entry/hnp/arm64-v8a"
  if [ -d "$HNP_SRC_DIR" ] && ls "$HNP_SRC_DIR"/*.hnp >/dev/null 2>&1; then
    # Prefer the bare hvigor unsigned.hap. The *unsigned*.hap glob also matched
    # the derived -packed/-signed copies (already hnp-injected), which appended
    # duplicate hnp/arm64-v8a entries. Next any non-signed, then signed (the
    # re-sign step overwrites its signature anyway).
    UNSIGNED_HAP="$(ls -t "$HAP_DIR"/entry/build/default/outputs/default/entry-default-unsigned.hap 2>/dev/null | head -1 || true)"
    if [ -z "$UNSIGNED_HAP" ]; then
      UNSIGNED_HAP="$(ls -t "$HAP_DIR"/entry/build/default/outputs/default/entry-default-*.hap 2>/dev/null | grep -v '\-signed\.hap$' | head -1 || true)"
    fi
    if [ -z "$UNSIGNED_HAP" ]; then
      UNSIGNED_HAP="$(ls -t "$HAP_DIR"/entry/build/default/outputs/default/entry-default-signed.hap 2>/dev/null | head -1 || true)"
    fi
    if [ -z "$UNSIGNED_HAP" ]; then
      echo "[hicodeer-ohos-build] ERROR: no HAP found under outputs/default to inject hnp into" >&2
      exit 1
    fi
    PACKED_HAP="${UNSIGNED_HAP%.hap}-packed.hap"
    echo "[hicodeer-ohos-build] inject hnp payloads: $UNSIGNED_HAP -> $PACKED_HAP"
    # Copy the HAP verbatim (streaming cp, not an in-memory zip rewrite) and
    # append each hnp payload as a NEW zip entry. Rewriting every entry with
    # ZipFile("w") + zin.read() pulled the largest STORED payload wholly into
    # RAM (~1.3G pre-strip libhicodeer.so), which stacked with hvigor/node and
    # the signer JVM to OOM the 11G host. Appending only rewrites the tail
    # central directory, so memory stays O(hnp size).
    cp -f "$UNSIGNED_HAP" "$PACKED_HAP"
    python3 - "$PACKED_HAP" "$HNP_SRC_DIR" <<'PY'
import json, os, sys, zipfile
hap, tools = sys.argv[1], sys.argv[2]
with zipfile.ZipFile(hap, "a", allowZip64=True) as zout:
    module_json = json.loads(zout.read("module.json"))
    declared = [h["package"] for h in module_json.get("module", {}).get("hnpPackages", [])]
    injected = 0
    for pkg in declared:
        payload = os.path.join(tools, pkg)
        if not os.path.isfile(payload):
            raise SystemExit("declared hnpPackages entry missing payload: " + payload)
        entry = zipfile.ZipInfo("hnp/arm64-v8a/" + pkg)
        # Preserve the source file's permission bits (bin/* must stay 0o755),
        # otherwise the installed ELF is not executable.
        entry.external_attr = (os.stat(payload).st_mode & 0xFFFF) << 16
        entry.compress_type = zipfile.ZIP_DEFLATED
        with open(payload, "rb") as payload_file:
            zout.writestr(entry, payload_file.read())
        injected += 1
print("injected %d hnp payload(s): %s" % (injected, ", ".join(declared)))
PY
    # 签名材料取自 hap/cerfile：证书 / Profile / keystore 三件套同名，对应
    # build-profile.json5 里的 signingConfigs。口令优先取 OHOS_SIGN_PWD；未显式
    # 给出时，从 build-profile.json5 中存下的密文就地解出——解密所需的随机密钥
    # 材料就在 keystore 同目录的 material/ 下，随材料一起搬运，因此更换证书
    # 三件套后无需再同步口令。
    : "${OHOS_SIGN_CER:="$(ls "$HAP_DIR"/cerfile/*.cer 2>/dev/null | head -1 || true)"}"
    : "${OHOS_SIGN_P7B:="$(ls "$HAP_DIR"/cerfile/*.p7b 2>/dev/null | head -1 || true)"}"
    : "${OHOS_SIGN_P12:="${OHOS_SIGN_CER%.cer}.p12"}"
    : "${OHOS_SIGN_ALIAS:="debugkey"}"
    if [ -z "${OHOS_SIGN_PWD:-}" ]; then
      OHOS_SIGN_PWD="$("$NODE_CMD" "$SCRIPT_DIR/read-sign-pwd.js" "$HAP_DIR")" || {
        echo "[hicodeer-ohos-build] ERROR: 无法从 $HAP_DIR 的签名材料解出口令，请用 OHOS_SIGN_PWD 指定" >&2
        exit 1
      }
    fi
    if [ -z "${OHOS_SIGN_CER:-}" ] || [ -z "${OHOS_SIGN_P7B:-}" ] || [ -z "$OHOS_SIGN_P12" ] || [ -z "$OHOS_SIGN_PWD" ]; then
      echo "[hicodeer-ohos-build] ERROR: OHOS_SIGN_CER / OHOS_SIGN_P7B / OHOS_SIGN_P12 / OHOS_SIGN_PWD 未配齐，无法重签；装配件(未签名): $PACKED_HAP" >&2
      exit 1
    fi
    SIGNED_HAP="${UNSIGNED_HAP%.hap}-signed.hap"
    echo "[hicodeer-ohos-build] sign-app -> $SIGNED_HAP"
    $NO_SHIM java -jar "$SIGN_TOOL_JAR" sign-app \
      -keyAlias "$OHOS_SIGN_ALIAS" -signAlg SHA256withECDSA -mode localSign \
      -appCertFile "$OHOS_SIGN_CER" -profileFile "$OHOS_SIGN_P7B" -keystoreFile "$OHOS_SIGN_P12" \
      -inFile "$PACKED_HAP" -outFile "$SIGNED_HAP" \
      -keyPwd "$OHOS_SIGN_PWD" -keystorePwd "$OHOS_SIGN_PWD" -signCode 1 -profileSigned 1
    # 稳定产物路径给 install_run.sh（其指向 outputs/default/entry-default-signed.hap）
    cp -f "$SIGNED_HAP" "$HAP_DIR/entry/build/default/outputs/default/entry-default-signed.hap"
    # 校验签名（与 build-harmony.sh 对齐，防止产出不可装的包）
    VERIFY_CHAIN="$(mktemp -t hicodeer-certchain.XXXXXX.cer)"
    VERIFY_PROFILE="$(mktemp -t hicodeer-profile.XXXXXX.p7b)"
    if ! $NO_SHIM java -jar "$SIGN_TOOL_JAR" verify-app -inFile "$SIGNED_HAP" \
          -outCertChain "$VERIFY_CHAIN" -outProfile "$VERIFY_PROFILE"; then
      rm -f "$VERIFY_CHAIN" "$VERIFY_PROFILE"
      echo "[hicodeer-ohos-build] ERROR: 签名校验失败: $SIGNED_HAP" >&2
      exit 1
    fi
    rm -f "$VERIFY_CHAIN" "$VERIFY_PROFILE"
    echo "[hicodeer-ohos-build] INSTALLABLE (with hnp): $HAP_DIR/entry/build/default/outputs/default/entry-default-signed.hap"
  else
    echo "[hicodeer-ohos-build] WARN: $HNP_SRC_DIR 无 .hnp 载荷，HAP 将不含本机 git/ssh（本地路由会报缺工具）" >&2
  fi

fi

echo ""
echo "=== HAP BUILD SUCCESSFUL ==="
echo "产物："
echo "  $HAP_DIR/entry/build/default/outputs/*/entry-*-*.hap"
echo "如需清理本地构建缓存：删除 $PROJECT_ROOT/build 目录"
