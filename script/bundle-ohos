#!/usr/bin/env bash

set -euo pipefail

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options]
Build a HarmonyOS NEXT HAP for zcoder.

Builds the Rust crate as a cdylib (libzcoder.so), stages it into the HAP
project's libs directory, and runs hvigor assembleHap.

Options:
  --release      Build in release mode (default: debug)
  --hap-only     Skip Rust builds; only run ohpm install + hvigor assembleHap
  -h, --help     Display this help and exit.

The command backend is the on-device zcoderd server: this script cross-compiles
the zcoderd executable (aarch64-unknown-linux-ohos), generates the fixed
management keys, and assembles zcoderd.hnp (public) so remote commands run on
the same device as zcoder (no VM / QEMU backend).
"
}

# Parse all arguments manually
IS_RELEASE=false
MODE="all"
CARGO_ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help)
      help_info
      exit 0
      ;;
    --release)
      IS_RELEASE=true
      shift
      ;;
    --hap-only)
      MODE="hap"
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      help_info
      exit 1
      ;;
    *)
      CARGO_ARGS+=("$1")
      shift
      ;;
  esac
done

# ==================== 路径配置 ====================
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"            # .../zcoder/script
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"           # .../zcoder
HAP_DIR="$PROJECT_ROOT/hap"

TOOLCHAIN="/mnt/linux_share/workspace/commandline-linux-arm64"
NODE_CMD="$TOOLCHAIN/tool/node/bin/node"
HVIGORW_JS="$TOOLCHAIN/hvigor/bin/hvigorw.js"
export DEVECO_SDK_HOME="$TOOLCHAIN/sdk"
export OHOS_BASE_SDK_HOME="$TOOLCHAIN/sdk"
export HARMONYBREW_SDK="$TOOLCHAIN/sdk"
OHPM_CMD="$TOOLCHAIN/ohpm/bin/ohpm"
SDK_LLVM_BIN="$TOOLCHAIN/sdk/default/openharmony/native/llvm/bin"

OHOS_TARGET="aarch64-unknown-linux-ohos"
CRATE="launch-zed"
OHOS_LIB_NAME="libzcoder.so"   # 产品名 zcoder，moduleName="zcoder"，与 EntryAbility 对应

PROFILE_DIR="debug"
BUILD_MODE="debug"
if [ "$IS_RELEASE" = true ]; then
  PROFILE_DIR="release"
  BUILD_MODE="release"
fi

# ==================== virtiofs 元数据 shim（LD_PRELOAD 放行 EPERM） ====================
# 共享盘（virtiofs）对非 root 的 fchmod/fchown/utimensat/copy_file_range 返回
# EPERM。此 shim 在真实调用仅因 EPERM 失败时返回成功（copy_file_range 则改为
# ENOSYS 触发调用方降级到 read/write），使 cargo 与 hvigor 的产物可直接写共享盘
# （无需 bind mount，与 DevEco Studio 共用同一份 build 输出）。本地文件系统不受影响。
SHIM_C="$TOOLCHAIN/tool/shim/ohos-meta-shim.c"
SHIM_SO="$TOOLCHAIN/tool/shim/ohos-meta-shim.so"
if [ ! -f "$SHIM_SO" ] || [ "$SHIM_C" -nt "$SHIM_SO" ]; then
  echo "[zcoder-ohos-build] 编译 virtiofs meta shim -> $SHIM_SO"
  gcc -shared -fPIC -o "$SHIM_SO" "$SHIM_C" -ldl
fi
export LD_PRELOAD="$SHIM_SO${LD_PRELOAD:+:$LD_PRELOAD}"
echo "[zcoder-ohos-build] LD_PRELOAD=$SHIM_SO"

# ==================== Cargo build（OHOS 交叉编译） ====================
# 工具链版本：zcoder 根 rust-toolchain.toml 指定 1.97.1。此前该工具链组件损坏
# （bin 目录缺 rustc/cargo，cargo 每次自修复失败），故临时绕到 warp 使用的 1.92.0。
# 1.97.1 组件已补全（rustup toolchain install 修复），且 merman 0.7.0 声明
# rust-version="1.95"，必须用 ≥1.95 的工具链，故恢复使用 1.97.1。
export RUSTUP_TOOLCHAIN=1.97.1
# 用 commandline-linux-arm64 的 clang wrapper（系统 clang-17 + OHOS target + sysroot）
export CC_aarch64_unknown_linux_ohos="$SDK_LLVM_BIN/clang"
export CXX_aarch64_unknown_linux_ohos="$SDK_LLVM_BIN/clang++"
export AR_aarch64_unknown_linux_ohos="$SDK_LLVM_BIN/llvm-ar"
export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_OHOS_LINKER="$SDK_LLVM_BIN/clang"
export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_OHOS_CXX="$SDK_LLVM_BIN/clang++"

# 完全脱离旧 SDK：覆盖用户 shell 残留的 OHOS 环境变量
SDK_NATIVE="$TOOLCHAIN/sdk/default/openharmony/native"
export OHOS_NDK_HOME="$SDK_NATIVE"
export CMAKE_TOOLCHAIN_FILE_aarch64_unknown_linux_ohos="$SDK_NATIVE/build/cmake/ohos.toolchain.cmake"
# aws-lc-sys 等 C crate 用 Unix Makefiles generator，需要 make 而非 ninja
export CMAKE_MAKE_PROGRAM="/usr/bin/make"

# 某些 C crate（zstd-sys/gettext-sys 等）需要额外 C 宏；
# clang-17 把 incompatible-function-pointer-types 当错误，必须显式关闭
export CFLAGS_aarch64_unknown_linux_ohos="-DZSTD_NOVMS -D__ANDROID__ -Wno-incompatible-function-pointer-types"
export RANLIB_aarch64_unknown_linux_ohos="$SDK_LLVM_BIN/llvm-ranlib"

# Rust 编译产物放本地磁盘 $HOME/rust-target：virtiofs 共享盘不支持硬链接，
# cargo 退化为逐文件拷贝，拖慢编译。每个编译目标一个独立子目录，当前用户
# 直接创建（无 sudo、无 bind mount）。只动 rust 的 target；hap 的 build
# （hap/entry/build）由 hvigor 管理，不受影响。
RUST_TARGET_ROOT="${HOME}/rust-target"
# Unique per source checkout: parallel builds of different zcoder copies must
# not share a cargo target dir (cargo locks it and fingerprints collide).
PROJECT_HASH="$(printf '%s' "$PROJECT_ROOT" | sha256sum | cut -c1-8)"

ensure_rust_target() {
  local name="$1"
  # Create the target dir as the current user: no sudo, no bind mount. It
  # lives under $HOME, which always supports hard links (the virtiofs share
  # does not, so cargo had to copy every file instead).
  mkdir -p "$RUST_TARGET_ROOT/${PROJECT_HASH}-${name}"
}

# NAPI 模块注册名：napi-derive-ohos 用 NAPI_BUILD_TARGET_NAME > CARGO_CRATE_NAME > CARGO_PKG_NAME
# 决定 nm_modname。zcoder 的 zed crate 包名是 "zed"，但 so 文件名是 libzcoder.so（产品名 zcoder），
# 二者必须一致，否则 loadNativeModule 找不到模块。设 NAPI_BUILD_TARGET_NAME=zcoder 使模块名与
# libzcoder.so 统一（EntryAbility.moduleName='zcoder'）。
export NAPI_BUILD_TARGET_NAME=zcoder

# 全量编译加 -A warnings 避免既有警告阻塞；
# codegen-units=16 降低编译内存峰值
export RUSTFLAGS="${RUSTFLAGS:-} -A warnings"
if [ "$IS_RELEASE" = true ]; then
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
else
  export CARGO_PROFILE_DEV_CODEGEN_UNITS=16
fi

cd "$PROJECT_ROOT"

# --hap-only 跳过 launch-zed 编译与 so 拷贝，直接复用现有 libzcoder.so
if [ "$MODE" != "hap" ]; then
  NPROC=$(nproc 2>/dev/null || echo 4)
  OHOS_TARGET_DIR="$RUST_TARGET_ROOT/${PROJECT_HASH}-ohos-$BUILD_MODE"
  ensure_rust_target "ohos-$BUILD_MODE"
  echo "[zcoder-ohos-build] Cargo build ($PROFILE_DIR, $NPROC CPUs) ..."
  # Default backend feature zcoderd-agent (cmd-client -> on-device zcoderd). No
  # feature flags are passed; the retired openeuler-agent / qemu-agent features
  # are gone.
  CARGO_TARGET_DIR="$OHOS_TARGET_DIR" \
    cargo build $($IS_RELEASE && echo --release) --lib -p "$CRATE" --target "$OHOS_TARGET" -j "$NPROC" "${CARGO_ARGS[@]}"

  # ==================== 拷贝 libzcoder.so ====================
  HAP_LIBS_DIR="$HAP_DIR/entry/libs/arm64-v8a"
  mkdir -p "$HAP_LIBS_DIR"
  # launch-zed 的 [lib] name 是 zcoder，产物直接是 libzcoder.so（无需改名）
  cp "$OHOS_TARGET_DIR/$OHOS_TARGET/$PROFILE_DIR/libzcoder.so" "$HAP_LIBS_DIR/$OHOS_LIB_NAME"
  echo "[zcoder-ohos-build] $OHOS_LIB_NAME staged at $HAP_LIBS_DIR/$OHOS_LIB_NAME"
fi

# ==================== zcoderd 编译 + 固定钥匙 + zcoderd.hnp 装配 ====================
# zcoderd is the on-device command server (replaces the retired cmd-agentd/VM
# and qemu-ssh-agentd/QEMU backends). It runs ON the OHOS device, so it is
# compiled with the OHOS (musl) target - unlike the old VM servers which used
# the host gnu toolchain. The fixed management keys are generated per build: the
# server half ships inside the zcoderd public HNP conf dir, the client half goes
# into the HAP resfile for cmd-client (both halves install together in the same
# HAP, so they always match). zcoderd.hnp is assembled into
# hap/entry/hnp/arm64-v8a/ and injected + re-signed by the HNP section below.
HAP_RESFILE_DIR="$HAP_DIR/entry/src/main/resources/resfile"
ZCODERD_MANIFEST="$PROJECT_ROOT/crates/gpui_ohos/depend/cmd-agent/zcoderd/Cargo.toml"
HNP_SRC_DIR="$HAP_DIR/entry/hnp/arm64-v8a"
mkdir -p "$HAP_RESFILE_DIR" "$HNP_SRC_DIR"

if [ "$MODE" != "hap" ]; then
  ZCODERD_TARGET_DIR="$RUST_TARGET_ROOT/${PROJECT_HASH}-zcoderd"
  ensure_rust_target "zcoderd"
  echo "[zcoder-ohos-build] Building zcoderd (OHOS $OHOS_TARGET) ..."
  CARGO_TARGET_DIR="$ZCODERD_TARGET_DIR" \
    cargo build --release --manifest-path "$ZCODERD_MANIFEST" --target "$OHOS_TARGET" -j "$NPROC"
  ZCODERD_BIN="$ZCODERD_TARGET_DIR/$OHOS_TARGET/release/zcoderd"
  if [ ! -x "$ZCODERD_BIN" ]; then
    echo "[zcoder-ohos-build] ERROR: zcoderd binary missing: $ZCODERD_BIN" >&2
    exit 1
  fi

  # Generate the fixed management key pairs for this build.
  KEYS_DIR="$RUST_TARGET_ROOT/${PROJECT_HASH}-zcoderd-keys"
  mkdir -p "$KEYS_DIR"
  if [ ! -f "$KEYS_DIR/mgmt_host_key" ]; then
    ssh-keygen -t ed25519 -N '' -f "$KEYS_DIR/mgmt_host_key" -q
    ssh-keygen -t ed25519 -N '' -f "$KEYS_DIR/mgmt_client_key" -q
  fi

  # Stage the public-HNP payload: <pkg>/bin/zcoderd + <pkg>/conf/<server keys>.
  STAGE_DIR="$RUST_TARGET_ROOT/${PROJECT_HASH}-zcoderd-stage"
  mkdir -p "$STAGE_DIR/zcoderd/bin" "$STAGE_DIR/zcoderd/conf"
  cp "$ZCODERD_BIN" "$STAGE_DIR/zcoderd/bin/zcoderd"
  chmod 755 "$STAGE_DIR/zcoderd/bin/zcoderd"
  cp "$KEYS_DIR/mgmt_host_key" "$STAGE_DIR/zcoderd/conf/mgmt_host_key"
  cp "$KEYS_DIR/mgmt_client_key.pub" "$STAGE_DIR/zcoderd/conf/authorized_keys"
  chmod 600 "$STAGE_DIR/zcoderd/conf/mgmt_host_key"
  cat > "$STAGE_DIR/zcoderd/hnp.json" <<'JSON'
{"type":"hnp-config","name":"zcoderd","version":"0.1.0","install":{}}
JSON

  # Client half of the management keys -> resfile (cmd-client reads them).
  mkdir -p "$HAP_RESFILE_DIR/zcoderd-mgmt"
  rm -f "$HAP_RESFILE_DIR/zcoderd-mgmt/mgmt-host.pub" "$HAP_RESFILE_DIR/zcoderd-mgmt/mgmt-client-key"
  cp "$KEYS_DIR/mgmt_host_key.pub" "$HAP_RESFILE_DIR/zcoderd-mgmt/mgmt-host.pub"
  cp "$KEYS_DIR/mgmt_client_key" "$HAP_RESFILE_DIR/zcoderd-mgmt/mgmt-client-key"
  chmod 600 "$HAP_RESFILE_DIR/zcoderd-mgmt/mgmt-client-key"

  # Assemble zcoderd.hnp with the official OpenHarmony packer (hnpcli). The SDK
  # hnpcli is x86-64 only; this toolchain ships a box64 wrapper at the same
  # path, so call it like a native binary. hnpcli reads the package name/version
  # from the staged zcoderd/hnp.json and emits <name>.hnp into -o.
  HNPCLI="$TOOLCHAIN/sdk/default/openharmony/toolchains/hnpcli"
  echo "[zcoder-ohos-build] Assembling zcoderd.hnp (hnpcli) ..."
  rm -f "$HNP_SRC_DIR/zcoderd.hnp"
  "$HNPCLI" pack -i "$STAGE_DIR/zcoderd" -o "$HNP_SRC_DIR"
  if [ ! -f "$HNP_SRC_DIR/zcoderd.hnp" ]; then
    echo "[zcoder-ohos-build] ERROR: hnpcli did not produce $HNP_SRC_DIR/zcoderd.hnp" >&2
    exit 1
  fi
  echo "[zcoder-ohos-build] zcoderd.hnp staged at $HNP_SRC_DIR/zcoderd.hnp"
fi

# Purge any stale VM/QEMU artifacts left from prior backends so the HAP never
# ships them (resfile cmd-agentd/ssh-agentd/Image/rootfs/tools, qemu native
# libs). ca-bundle.crt and the client-half keys stay.
QEMU_HAP_LIBS_DIR="$HAP_DIR/entry/libs/arm64-v8a"
rm -f "$HAP_RESFILE_DIR/cmd-agentd" \
      "$HAP_RESFILE_DIR/ssh-agentd" \
      "$HAP_RESFILE_DIR/Image" \
      "$HAP_RESFILE_DIR/rootfs.cpio.zst" \
      "$HAP_RESFILE_DIR/rootfs.cpio.gz" \
      "$HAP_RESFILE_DIR/.complete"
rm -f "$QEMU_HAP_LIBS_DIR/libqemu-system-aarch64.so" \
      "$QEMU_HAP_LIBS_DIR/libslirp.so.0" \
      "$QEMU_HAP_LIBS_DIR/libz.so.1" \
      "$QEMU_HAP_LIBS_DIR/libpixman-1.so.0" \
      "$QEMU_HAP_LIBS_DIR/libglib-2.0.so.0" \
      "$QEMU_HAP_LIBS_DIR/libintl.so.8" \
      "$QEMU_HAP_LIBS_DIR/libpcre2-8.so.0"
echo "[zcoder-ohos-build] VM/QEMU artifacts purged from HAP"

# ==================== cmd-agent daemon（线程运行，无需 cdylib） ====================
# The cmd-agent daemon now runs as a zcoder thread (spawned in launch-zed's
# launch_app.rs), so libcmd_agent.so is no longer built or packaged.

# --server-only 跳过 ohpm install 与 hvigor 打包
if [ "$MODE" != "server" ]; then

# ==================== ohpm install（首次 / 为空 / 有坏符号链接 / 关键 so 链接缺失时） ====================
# 说明：hvigor 在 DevEco Studio 里会自动触发 ohpm install；命令行 assembleHap 不一定触发。
# 新增 Rust so 依赖（libzcoder.so）后，若 oh_modules 里缺对应符号链接，ArkTS 编译报
# "Cannot find module 'libxxx.so'"。此处兜底：顶层与 entry 两处 oh_modules 的关键 so 链接
# 齐全才跳过 install，否则补跑（顶层 + entry 各一次）。
OHPM_LINK_DEPS=(
  "$OHOS_LIB_NAME"   # 工程 Rust NAPI 引擎库（与 OHOS_LIB_NAME 一致）
)
ohpm_links_missing() {
  # 顶层 oh_modules 关键 so 链接
  local dep
  for dep in "${OHPM_LINK_DEPS[@]}"; do
    if [ ! -L "$HAP_DIR/oh_modules/$dep" ]; then
      return 0
    fi
  done
  # entry 级 oh_modules 关键 so 链接 + @ohos-rs/ability 解析
  for dep in "${OHPM_LINK_DEPS[@]}"; do
    if [ ! -L "$HAP_DIR/entry/oh_modules/$dep" ]; then
      return 0
    fi
  done
  if [ ! -L "$HAP_DIR/entry/oh_modules/@ohos-rs/ability" ]; then
    return 0
  fi
  # entry 级 @ohos-rs/ability 能力插件链接（新增插件必须在此登记）
  local plugin
  for plugin in ability-plugin-cursor ability-plugin-files ability-plugin-pinch ability-plugin-filedrop ability-plugin-ime; do
    if [ ! -L "$HAP_DIR/entry/oh_modules/@ohos-rs/$plugin" ]; then
      return 0
    fi
  done
  # 目录为空或坏符号链接（保留原有兜底）
  local dir
  for dir in "$HAP_DIR/oh_modules" "$HAP_DIR/entry/oh_modules"; do
    if [ ! -d "$dir" ] || [ -z "$(ls -A "$dir" 2>/dev/null)" ]; then
      return 0
    fi
    local link
    while IFS= read -r -d '' link; do
      if [ -L "$link" ] && [ ! -e "$link" ]; then
        return 0
      fi
    done < <(find "$dir" -type l -print0 2>/dev/null)
  done
  return 1
}
if ohpm_links_missing; then
  echo "[zcoder-ohos-build] ohpm install (top-level) ..."
  PATH="$TOOLCHAIN/tool/node/bin:$TOOLCHAIN/ohpm/bin:$PATH" \
    bash -c "cd '$HAP_DIR' && '$OHPM_CMD' install --all"
  echo "[zcoder-ohos-build] ohpm install (entry) ..."
  PATH="$TOOLCHAIN/tool/node/bin:$TOOLCHAIN/ohpm/bin:$PATH" \
    bash -c "cd '$HAP_DIR/entry' && '$OHPM_CMD' install"
fi

# ==================== 清理 stale cmake/ninja ====================
CXX_DIR="$HAP_DIR/entry/.cxx/default/default/$BUILD_MODE/arm64-v8a"
rm -f "$CXX_DIR/.ninja_log" "$CXX_DIR/.ninja_deps" 2>/dev/null || true

# ==================== hvigor assembleHap ====================
cd "$HAP_DIR"   # hvigor 必须在 HAP 工程根目录运行（找 hvigor-config.json5 / build-profile.json5）
# 停止旧 daemon：hvigor daemon 常驻并缓存启动时的环境变量（DEVECO_SDK_HOME 等）
"$NODE_CMD" "$HVIGORW_JS" --stop-daemon 2>/dev/null || true

echo "=== HAP Build ==="
echo "Project : $HAP_DIR"
echo "Node    : $("$NODE_CMD" --version)"
echo "SDK     : $DEVECO_SDK_HOME"
echo "Mode    : $BUILD_MODE"
echo ""

"$NODE_CMD" "$HVIGORW_JS" \
  --mode module \
  -p product=default \
  -p buildMode="$BUILD_MODE" \
  assembleHap \
  --info --analyze=normal --parallel --incremental --no-daemon

  # ==================== 清理 cmake staging ====================
  CMAKE_STAGING_DIR="$HAP_DIR/entry/.cmake_staging"
  if [ -d "$CMAKE_STAGING_DIR" ]; then
    find "$CMAKE_STAGING_DIR" -depth -delete 2>/dev/null || true
  fi

  # ==================== HNP 装配（注入载荷 + 重签，默认执行） ====================
  # hvigor 只把 module.json 的 hnpPackages 写进产物、不嵌 .hnp 实体；这里把
  # hap/entry/hnp/arm64-v8a/<pkg>.hnp 追加进 HAP，再用调试证书整体重签。
  # 载荷缺失 / 证书未配齐都会显式报错，不产出“看似可装”的包。
  HNP_SRC_DIR="$HAP_DIR/entry/hnp/arm64-v8a"
  SIGN_TOOL_JAR="$TOOLCHAIN/sdk/default/openharmony/toolchains/lib/hap-sign-tool.jar"
  if [ -d "$HNP_SRC_DIR" ] && ls "$HNP_SRC_DIR"/*.hnp >/dev/null 2>&1; then
    # 优先 unsigned，其次任意非 -signed，最后回退 signed（重签会覆盖旧签名）。
    UNSIGNED_HAP="$(ls -t "$HAP_DIR"/entry/build/default/outputs/default/*unsigned*.hap 2>/dev/null | head -1 || true)"
    if [ -z "$UNSIGNED_HAP" ]; then
      UNSIGNED_HAP="$(ls -t "$HAP_DIR"/entry/build/default/outputs/default/entry-default-*.hap 2>/dev/null | grep -v '\-signed\.hap$' | head -1 || true)"
    fi
    if [ -z "$UNSIGNED_HAP" ]; then
      UNSIGNED_HAP="$(ls -t "$HAP_DIR"/entry/build/default/outputs/default/entry-default-signed.hap 2>/dev/null | head -1 || true)"
    fi
    if [ -z "$UNSIGNED_HAP" ]; then
      echo "[zcoder-ohos-build] ERROR: no HAP found under outputs/default to inject hnp into" >&2
      exit 1
    fi
    PACKED_HAP="${UNSIGNED_HAP%.hap}-packed.hap"
    echo "[zcoder-ohos-build] inject hnp payloads: $UNSIGNED_HAP -> $PACKED_HAP"
    python3 - "$UNSIGNED_HAP" "$PACKED_HAP" "$HNP_SRC_DIR" <<'PY'
import json, os, sys, zipfile
src, out, tools = sys.argv[1], sys.argv[2], sys.argv[3]
zin = zipfile.ZipFile(src)
module_json = json.loads(zin.read("module.json"))
declared = [h["package"] for h in module_json.get("module", {}).get("hnpPackages", [])]
with zipfile.ZipFile(out, "w", allowZip64=True) as zout:
    for info in zin.infolist():
        zout.writestr(info, zin.read(info.filename))
    injected = 0
    for pkg in declared:
        payload = os.path.join(tools, pkg)
        if not os.path.isfile(payload):
            raise SystemExit("declared hnpPackages entry missing payload: " + payload)
        entry = zipfile.ZipInfo("hnp/arm64-v8a/" + pkg)
        # Preserve the source file's permission bits (bin/* must stay 0o755),
        # otherwise the installed ELF is not executable.
        entry.external_attr = (os.stat(payload).st_mode & 0xFFFF) << 16
        entry.compress_type = zipfile.ZIP_DEFLATED
        with open(payload, "rb") as payload_file:
            zout.writestr(entry, payload_file.read())
        injected += 1
zin.close()
print("injected %d hnp payload(s): %s" % (injected, ", ".join(declared)))
PY
    # 签名默认值（env 可覆盖）：证书/Profile/keystore 全部取自 hap/cerfile 的
    # default_zcoder*（com.zcoder.studio 可签三件套，明文口令见下）。该套是
    # github/zcoder 拷贝的已验证可装证书；更换签名时覆盖 hap/cerfile 三件套并
    # 同步更新 OHOS_SIGN_PWD。
    : "${OHOS_SIGN_CER:="$(ls "$HAP_DIR"/cerfile/*.cer 2>/dev/null | head -1 || true)"}"
    : "${OHOS_SIGN_P7B:="$(ls "$HAP_DIR"/cerfile/*.p7b 2>/dev/null | head -1 || true)"}"
    : "${OHOS_SIGN_P12:="${OHOS_SIGN_CER%.cer}.p12"}"
    : "${OHOS_SIGN_ALIAS:="debugkey"}"
    : "${OHOS_SIGN_PWD:="mMahnPUzBCojAkQk"}"
    if [ -z "${OHOS_SIGN_CER:-}" ] || [ -z "${OHOS_SIGN_P7B:-}" ] || [ -z "$OHOS_SIGN_P12" ] || [ -z "$OHOS_SIGN_PWD" ]; then
      echo "[zcoder-ohos-build] ERROR: OHOS_SIGN_CER / OHOS_SIGN_P7B / OHOS_SIGN_P12 / OHOS_SIGN_PWD 未配齐，无法重签；装配件(未签名): $PACKED_HAP" >&2
      exit 1
    fi
    SIGNED_HAP="${UNSIGNED_HAP%.hap}-signed.hap"
    echo "[zcoder-ohos-build] sign-app -> $SIGNED_HAP"
    java -jar "$SIGN_TOOL_JAR" sign-app \
      -keyAlias "$OHOS_SIGN_ALIAS" -signAlg SHA256withECDSA -mode localSign \
      -appCertFile "$OHOS_SIGN_CER" -profileFile "$OHOS_SIGN_P7B" -keystoreFile "$OHOS_SIGN_P12" \
      -inFile "$PACKED_HAP" -outFile "$SIGNED_HAP" \
      -keyPwd "$OHOS_SIGN_PWD" -keystorePwd "$OHOS_SIGN_PWD" -signCode 1 -profileSigned 1
    # 稳定产物路径给 install_run.sh（其指向 outputs/default/entry-default-signed.hap）
    cp -f "$SIGNED_HAP" "$HAP_DIR/entry/build/default/outputs/default/entry-default-signed.hap"
    echo "[zcoder-ohos-build] INSTALLABLE (with hnp): $HAP_DIR/entry/build/default/outputs/default/entry-default-signed.hap"
  else
    echo "[zcoder-ohos-build] WARN: $HNP_SRC_DIR 无 .hnp 载荷，HAP 将不含本机 git/ssh（本地路由会报缺工具）" >&2
  fi

fi

echo ""
echo "=== HAP BUILD SUCCESSFUL ==="
echo "产物："
echo "  $HAP_DIR/entry/build/default/outputs/*/entry-*-*.hap"
echo "如需清理本地构建缓存：删除 $PROJECT_ROOT/build 目录"
