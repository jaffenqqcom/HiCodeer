# The HAP resfile is populated by bundle-ohos at build time (guest kernel
# Image, golden.qcow2, guest daemon, per-build management keys). Only the CA
# bundle is a checked-in source; everything else is a build artifact.
hap/entry/src/main/resources/resfile/*
!hap/entry/src/main/resources/resfile/ca-bundle.crt
