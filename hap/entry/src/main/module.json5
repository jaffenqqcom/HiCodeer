{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:foreground",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "metadata": [
          {
            "name": "ohos.ability.window.isMaximize",
            "value": "true"
          }
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "entities": [
              "entity.system.default"
            ],
            "actions": [
              "ohos.want.action.viewData",
              "ohos.want.action.sendData",
              "ohos.want.action.sendMultipleData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "general.plain-text",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.text",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.source-code",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.markdown",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.json",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.xml",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.html",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.css",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.type-script",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.java-script",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.python-script",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.shell-script",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.comma-separated-values-text",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "pathRegex": ".*\\.(rs|markdown|md|txt|toml|json5|jsonc|json|ets|yml|yaml|css|scss|jsx|mjs|cjs|js|tsx|mts|cts|ts|c|h|cc|cpp|hpp|pyi|py|mod|go|work|lock|patch|diff|gitcommit|log|csv|xml|html|sh|bash)$",
                "linkFeature": "FileOpen"
              }
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST",
        "reason": "$string:perm_auth_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY",
        "reason": "$string:perm_writable_code_memory_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}